# Root .env - used by the full stack (`docker compose up` in this folder). It is read for ${...}
# interpolation in docker-compose.yml and bcube-services/docker-compose.yml.
# Copy to .env and fill in. Never commit the real .env.
#
# Service-specific secrets (Stripe, Google, SMTP, ...) live in bcube-services/<service>/.env.
# For local development without the full stack see bcube-services/.env.example.

# --- Database ---------------------------------------------------------------
# Credentials for every service's Postgres container and datasource.
DB_USER=
DB_PASSWORD=

# --- Security ---------------------------------------------------------------
# HMAC secret for JWTs, passed to every service that needs it. Generate: openssl rand -base64 48
JWT_SECRET=
# Shared secret for server-to-server calls (user/booking/payment/access).
# Generate: openssl rand -base64 48
INTERNAL_SERVICE_KEY=
