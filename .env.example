# Root .env - read by `docker compose` (docker-compose.yml in this folder) for ${...} interpolation.
# Copy to .env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Credentials for every service's Postgres container and datasource.
DB_USER=
DB_PASSWORD=

# --- Security ---------------------------------------------------------------
# HMAC secret for JWTs. Must be identical to JWT_SECRET in every service .env.
# Generate: openssl rand -base64 48
JWT_SECRET=
