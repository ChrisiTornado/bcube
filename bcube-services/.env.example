# Shared values for local development (services started from the IDE + databases from
# bcube-services/docker-compose.yml). Copy to .env and fill in. Never commit the real .env.
#
# Each service loads this file automatically (spring.config.import=optional:file:../.env) in
# addition to its own bcube-services/<service>/.env - no IDE run-config setup needed.
# The full stack (root docker-compose.yml) does not use this file; it takes these values from the
# root .env instead.

# --- Database ---------------------------------------------------------------
# Optional. Defaults admin/admin match each service's application.properties.
DB_USER=admin
DB_PASSWORD=admin

# --- Security ---------------------------------------------------------------
# Must be identical in all services. Generate: openssl rand -base64 48
JWT_SECRET=
# Shared secret for server-to-server calls. Identical in user/booking/payment/access.
# Generate: openssl rand -base64 48
INTERNAL_SERVICE_KEY=
