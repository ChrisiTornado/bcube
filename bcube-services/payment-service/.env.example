# payment-service - copy to .env (cp .env.example .env) and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Used by this service's docker-compose.yml and the local run. application.properties
# currently hardcodes admin/admin on localhost:5437, so use those values for local dev.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Read by the Postgres container in the root docker-compose.yml (via env_file). Same values as above.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Security ---------------------------------------------------------------
# Must be identical in all services. Generate: openssl rand -base64 48
JWT_SECRET=
# Shared secret for server-to-server calls. Identical in user/booking/payment/access.
INTERNAL_SERVICE_KEY=

# --- Stripe -----------------------------------------------------------------
# Test vs. live is purely which keys you put here (sk_test_..., whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- URLs -------------------------------------------------------------------
# Empty overrides the default, so fill in or delete the line. Default: http://localhost:8081/api/users
USER_SERVICE_BASE_URL=

# --- Misc -------------------------------------------------------------------
SHOW_SQL=
