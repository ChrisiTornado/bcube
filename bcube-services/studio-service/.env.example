# studio-service - copy to .env (cp .env.example .env) and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Used by this service's docker-compose.yml and the local run. application.properties
# currently hardcodes admin/admin on localhost:5434, so use those values for local dev.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Read by the Postgres container in the root docker-compose.yml (via env_file). Same values as above.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Security ---------------------------------------------------------------
# Must be identical in all services. Generate: openssl rand -base64 48
JWT_SECRET=

# --- URLs -------------------------------------------------------------------
# Empty overrides the default, so fill in or delete the line.
# Defaults: http://localhost:4200 | http://localhost:8083/api/bookings
FRONTEND_URL=
BOOKING_SERVICE_BASE_URL=

# --- AWS S3 for studio images (optional) ------------------------------------
# Credentials come from the default AWS provider chain (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, ~/.aws or an IAM role), not from this file.
# Default region: eu-central-1
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL_BASE=

# --- Misc -------------------------------------------------------------------
SHOW_SQL=
