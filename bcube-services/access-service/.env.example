# access-service - copy to .env (cp .env.example .env) and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Used by this service's docker-compose.yml and the local run. application.properties
# currently hardcodes admin/admin on localhost:5436, so use those values for local dev.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Read by the Postgres container in the root docker-compose.yml (via env_file). Same values as above.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Security ---------------------------------------------------------------
# Shared secret for server-to-server calls. Identical in user/booking/payment/access.
INTERNAL_SERVICE_KEY=
# Base64 AES key used to encrypt access codes. Generate: openssl rand -base64 32
ACCESS_AES_KEY=

# --- Nuki smartlock ---------------------------------------------------------
NUKI_API_TOKEN=

# --- URLs / misc ------------------------------------------------------------
# Empty overrides the default, so fill in or delete the line. Default: http://localhost:4200
FRONTEND_URL=
SHOW_SQL=
