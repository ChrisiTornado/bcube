# access-service - copy to .env (cp .env.example .env) and fill in. Never commit the real .env.

# --- Security ---------------------------------------------------------------
# Base64 AES key used to encrypt access codes. Generate: openssl rand -base64 32
ACCESS_AES_KEY=

# --- Nuki smartlock ---------------------------------------------------------
NUKI_API_TOKEN=
# true = mocked Nuki calls (default). Set false in production.
NUKI_MOCK_ENABLED=

# --- URLs / misc ------------------------------------------------------------
# Empty overrides the default, so fill in or delete the line. Default: http://localhost:4200
FRONTEND_URL=
SHOW_SQL=
