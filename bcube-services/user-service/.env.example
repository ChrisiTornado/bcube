# user-service - copy to .env (cp .env.example .env) and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Used by this service's docker-compose.yml and the local run. application.properties
# currently hardcodes admin/admin on localhost:5433, so use those values for local dev.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Read by the Postgres container in the root docker-compose.yml (via env_file). Same values as above.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Security ---------------------------------------------------------------
# Must be identical in all services. Generate: openssl rand -base64 48
JWT_SECRET=
# Shared secret for server-to-server calls. Identical in user/booking/payment/access.
INTERNAL_SERVICE_KEY=

# --- Google OAuth -----------------------------------------------------------
# Client secret from the Google Cloud console (the client-id is in application.properties).
GOOGLE_CLIENT_SECRET=
# Default: http://localhost:8080/login/oauth2/code/google
OAUTH_REDIRECT_URI=

# --- Mail (SMTP, smtp.gmail.com) --------------------------------------------
SPRING_MAIL_USERNAME=
# For Gmail: an app password, not the account password.
SPRING_MAIL_PASSWORD=

# --- Admin bootstrap (optional) ---------------------------------------------
# If both are set, an admin user is created at startup. Leave empty to skip.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- URLs -------------------------------------------------------------------
# Empty overrides the default, so fill in or delete the line.
# Defaults: http://localhost:4200 | :8085/api/payments | :8083/api/bookings
FRONTEND_URL=
PAYMENT_SERVICE_BASE_URL=
BOOKING_SERVICE_BASE_URL=

# --- Misc -------------------------------------------------------------------
# true logs SQL queries. Default: false
SHOW_SQL=
