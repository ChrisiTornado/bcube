# booking-service - copy to .env (cp .env.example .env) and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Used by this service's docker-compose.yml and the local run. application.properties
# currently hardcodes admin/admin on localhost:5435, so use those values for local dev.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Read by the Postgres container in the root docker-compose.yml (via env_file). Same values as above.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Security ---------------------------------------------------------------
# Must be identical in all services. Generate: openssl rand -base64 48
JWT_SECRET=
# Shared secret for server-to-server calls. Identical in user/booking/payment/access.
INTERNAL_SERVICE_KEY=

# --- URLs -------------------------------------------------------------------
# Empty overrides the default, so fill in or delete the line.
# Defaults: http://localhost:4200 | :8081/api/users | :8082/api/studios | :8084/api/access
#           :8085/api/payments | :8081/api/notifications
FRONTEND_URL=
USER_SERVICE_BASE_URL=
STUDIO_SERVICE_BASE_URL=
ACCESS_SERVICE_BASE_URL=
PAYMENT_SERVICE_BASE_URL=
NOTIFICATION_SERVICE_BASE_URL=

# --- Misc -------------------------------------------------------------------
SHOW_SQL=
