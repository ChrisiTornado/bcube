# Copy to terraform.tfvars and fill in real values. Never commit terraform.tfvars itself if it
# ends up holding anything sensitive - db_master_password especially should come from
# TF_VAR_db_master_password in your shell/CI secret store instead, not this file.

aws_region          = "eu-central-1"
environment         = "prod"
domain_name         = "bcube.at"                                     # PLACEHOLDER
acm_certificate_arn = "arn:aws:acm:eu-central-1:123456789012:certificate/REPLACE_ME" # PLACEHOLDER
