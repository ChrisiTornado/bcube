# @fullcalendar/daygrid and @fullcalendar/interaction have no stable release yet (only 7.0.0-rc.0
# is published), whose peer range still caps out at Angular 19. @fullcalendar/angular/core did
# reach a stable 7.0.x with an Angular 21-compatible peer range, but the other two haven't caught up.
legacy-peer-deps=true
